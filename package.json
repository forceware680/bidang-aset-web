{
  "name": "bidang-aset-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi Agenda Surat dan Jadwal Rapat, Bidang Aset BPKAD Kota Magelang",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "cmd /c \"set TURNSTILE_SKIP=1&& next dev --webpack\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:pull": "prisma db pull",
    "db:gen": "prisma generate",
    "db:apply": "psql -d agenda_aset -f db/schema.sql",
    "db:user": "node scripts/add-user.mjs",
    "logo:optimize": "node scripts/optimize-logo.mjs",
    "test:klik": "node --experimental-strip-types scripts/click-through.mts",
    "test:keluar": "node --experimental-strip-types scripts/keluar-check.mts",
    "test:modal": "node --experimental-strip-types scripts/modal-check.mts",
    "test:monitor": "node --experimental-strip-types scripts/monitor-check.mts",
    "migrate:keluar": "node --experimental-strip-types scripts/migrate-surat-keluar.mts",
    "migrate:monitor": "node --experimental-strip-types scripts/migrate-monitor.mts",
    "migrate:rapat": "node --experimental-strip-types scripts/migrate-rapat-mandiri.mts",
    "test:layout": "node scripts/layout-check.mjs",
    "test:kontras": "node scripts/contrast.mjs",
    "test:tampilan": "node scripts/shots.mjs",
    "test:rapat": "node --experimental-strip-types scripts/rapat-surat-check.mts",
    "test:rapat-waktu": "node --experimental-strip-types scripts/rapat-waktu-check.mts",
    "test:agenda-ubah": "node --experimental-strip-types scripts/agenda-ubah-check.mts",
    "migrate:pegawai": "node --experimental-strip-types scripts/migrate-pegawai.mts",
    "migrate:api": "node --experimental-strip-types scripts/migrate-api.mts",
    "test:api": "node --experimental-strip-types scripts/api-check.mts",
    "migrate:memberi": "node --experimental-strip-types scripts/migrate-memberi.mts",
    "migrate:monitor-token": "node --experimental-strip-types scripts/migrate-monitor-token.mts",
    "migrate:pemberitahuan": "node --experimental-strip-types scripts/migrate-pemberitahuan.mts",
    "migrate:nomor": "node --experimental-strip-types scripts/migrate-nomor.mts",
    "migrate:apk": "node --experimental-strip-types scripts/migrate-apk.mts",
    "test:sse": "node --experimental-strip-types scripts/sse-check.mts",
    "test:e2e": "cmd /c \"set TURNSTILE_SKIP=1&& e2e run\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "exceljs": "^3.4.0",
    "lucide-react": "^1.64.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "e2e": "^0.23.1",
    "playwright": "^1.64.1",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
